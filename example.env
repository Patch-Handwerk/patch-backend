# App
PORT=3002

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=your_secret
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_SECRET=your_refresh_secret
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=patch_db
TYPEORM_SYNC=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Admin (auto-created on first login)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=ADMIN_*
LINKEDIN_CLIENT_SECRET=ADMIN_*
LINKEDIN_CALLBACK_URL=http://localhost:3002/auth/linkedin/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=ADMIN_*
GITHUB_CLIENT_SECRET=ADMIN_*
GITHUB_CALLBACK_URL=http://localhost:3002/auth/github/callback

# Email (for password reset, etc.)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=